rules_version = '2';

// Deny everything.
//
// This is not a placeholder — it is the design. The mobile app never holds a
// Firestore credential: it authenticates to the MiDoctor API with its own
// access token, and the API reaches Firestore with the Admin SDK, which bypasses
// these rules entirely.
//
// Enforcing authorization in exactly one place is what makes it reviewable.
// Duplicating the RBAC matrix into security rules would mean two implementations
// of consent expiry, provider approval and scope checks that must agree forever
// — and the day they disagree, the weaker one is the one that decides.
//
// If a future feature needs direct client access to Firestore (offline caching,
// say), that is a deliberate architectural change and the rules for it belong
// here, scoped to exactly those collections. Until then: nothing.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
